NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/pdf_chat_ai
REDIS_URL=redis://127.0.0.1:6379
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:4173,http://localhost:5173,http://localhost:8080
# Require a valid InsForge Bearer token on API routes (recommended in production).
AUTH_REQUIRED=false
INSFORGE_URL=
TRUST_PROXY=1
JSON_BODY_LIMIT=1048576
MAX_QUERY_CHARS=4000
REQUEST_TIMEOUT_MS=120000

# Docker Compose secrets (used by docker compose up)
POSTGRES_USER=pdfchat
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pdf_chat_ai
REDIS_PASSWORD=changeme

# Use "auto" to pick OpenAI when OPENAI_API_KEY is set, otherwise mock.
# Mock embeddings are SHA-256 hashes (not trainable). For real retrieval:
#   1. Set OPENAI_API_KEY (20+ chars)
#   2. Restart the API
#   3. npm run reprocess:all
#   4. npm run eval:compare
# Or set explicitly: openai | mock
LLM_PROVIDER=auto
EMBEDDING_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=1600

# OCR fallback for scanned/image-only pages (tesseract.js + @napi-rs/canvas).
# Higher scale improves accuracy on small type but costs render time.
OCR_RENDER_SCALE=2
OCR_LANGUAGE=eng

# Per-user rate limits (each X-Client-Id / IP has its own budget)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_SEARCH_MAX=20
RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_GENERAL_MAX=120

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
MAX_FILE_SIZE=524288000
UPLOAD_CHUNK_SIZE=10485760
DATABASE_POOL_MAX=1
VITE_API_BASE_URL=http://localhost:5000/api

# InsForge auth. Anon key: npx @insforge/cli secrets get ANON_KEY
# Leave blank to run the app without sign-in.
VITE_INSFORGE_URL=
VITE_INSFORGE_ANON_KEY=
